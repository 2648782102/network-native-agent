# Optional Phase 2 model cognition organ.
# Export these variables in your shell, or use your own local secret loader.
# This runtime does not automatically read .env files; do not commit real keys.
NNA_COGNITION=deterministic
NNA_MODEL_BASE_URL=
NNA_MODEL_URL=
NNA_MODEL_API_KEY=
NNA_MODEL_NAME=default
NNA_MODEL_TIMEOUT_MS=15000
# chat or responses; responses requires a Responses-compatible gateway
NNA_MODEL_WIRE=chat
# Optional JSON object for non-auth gateway headers
NNA_MODEL_EXTRA_HEADERS=
